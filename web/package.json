{
  "name": "concurrency-theatre",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Executable companion to ParallelProgrammingTex: deterministic concurrency laboratories and measured browser experiments.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test --test-isolation=none tests/*.test.js",
    "test:coverage": "node --test --test-isolation=none --experimental-test-coverage tests/*.test.js",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
    "check": "npm test && npm run build"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
